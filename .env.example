# Model the Gathering - local environment example
# Copy to .env only if your shell/tooling loads .env files automatically.
# The Python runtime reads these values from the process environment.

# Java executable used for Forge and Java bridge JARs.
# Leave as "java" when Java is already on PATH.
LLMTG_JAVA=java

# Root of a Card-Forge/forge source checkout.
# Example (Windows): D:/code/forge
LLMTG_FORGE_HOME=

# Optional explicit built desktop JAR. If omitted and LLMTG_FORGE_HOME is set,
# llmtg looks under forge-gui-desktop/target automatically.
LLMTG_FORGE_JAR=

# Optional explicit working directory. Forge desktop builds commonly expect
# resources relative to the forge-gui directory. If omitted and that directory
# exists under LLMTG_FORGE_HOME, llmtg resolves it automatically.
LLMTG_FORGE_WORKING_DIR=

# External bridge implementing docs/forge-bridge.md protocol v1.
# Supported paths: Python script, executable, or JAR.
# For the development stub:
# LLMTG_FORGE_BRIDGE=scripts/forge_bridge_stub.py
LLMTG_FORGE_BRIDGE=
